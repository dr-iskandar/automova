{
  "name": "automova-dwi-production",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "node --disable-warning=ExperimentalWarning server/api-server.mjs",
    "dev:full": "concurrently -k -n DATABASE,APP -c green,blue \"npm run dev:api\" \"npm run dev -- --hostname 0.0.0.0\"",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:ui": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 0.0.0.0 --port 3030",
    "start:lan": "concurrently -k -n DATABASE,APP -c green,blue \"npm run start:database\" \"npm run start:ui\"",
    "start:database": "node --disable-warning=ExperimentalWarning server/api-server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "concurrently": "9.2.4",
    "drizzle-orm": "0.45.2",
    "next": "^16.2.11",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
